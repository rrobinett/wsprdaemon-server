<!--
  wd-system-log-ttl.xml - cap ClickHouse's own system.* log tables.
  Installed by install-servers.sh to /etc/clickhouse-server/config.d/.
  Default retention 7 days; trace_log, metric_log and
  asynchronous_metric_log (the biggest) keep 3 days.

  Rules:
    * <ttl> and <engine> are mutually exclusive in a system log element.
    * Applies only to log tables CREATED after this file is loaded.  When
      the definition changes ClickHouse renames the old table to <name>_0
      (then _1, ...) and creates a new one.  Existing tables need
      ch-system-log-ttl (opt-in, see README); *_N leftovers must be
      dropped by hand.
    * Keep in sync with ch-system-log-ttl, which reads this file.
    * THIS FILE IS A TEMPLATE, NOT INSTALLED VERBATIM.  A <foo_log> section
      in config.d ENABLES that log even if the server has it off, so
      install-servers.sh renders a copy containing only the log tables that
      already exist on the running server (clickhouse-config/
      render-system-log-ttl.py).  The <ttl> values here are the single
      source of truth for both the installer and ch-system-log-ttl.
-->
<clickhouse>
    <trace_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </trace_log>
    <metric_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </metric_log>
    <asynchronous_metric_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </asynchronous_metric_log>
    <query_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </query_log>
    <query_thread_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </query_thread_log>
    <query_views_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </query_views_log>
    <part_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </part_log>
    <text_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </text_log>
    <session_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </session_log>
    <error_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </error_log>
    <zookeeper_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </zookeeper_log>
    <crash_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </crash_log>
    <backup_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </backup_log>
    <blob_storage_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </blob_storage_log>
    <asynchronous_insert_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </asynchronous_insert_log>
    <filesystem_cache_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </filesystem_cache_log>
    <s3queue_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </s3queue_log>
    <background_schedule_pool_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </background_schedule_pool_log>
    <transactions_info_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </transactions_info_log>
    <!-- opentelemetry_span_log deliberately omitted: on ClickHouse 25.11
         ALTER TABLE system.opentelemetry_span_log MODIFY TTL fails with
         Code 44 ILLEGAL_COLUMN ("Cannot add subcolumn attribute.values:
         column with this name already exists").  Neither the installer nor
         ch-system-log-ttl touches it.
         (It would be: finish_date + INTERVAL 7 DAY DELETE) -->
</clickhouse>
