[Unit]
Description=Reconcile ClickHouse tables with peer WD servers (last 48 h)
After=clickhouse-server.service network-online.target
Requires=clickhouse-server.service

[Service]
Type=oneshot
User=wsprdaemon
Group=wsprdaemon
ExecStart=/usr/local/sbin/ch-sync-peers
TimeoutStartSec=2h
StandardOutput=null
StandardError=journal
