[Unit]
Description=Reconcile ClickHouse tables with peer WD servers (deep pass, last 30 days)
After=clickhouse-server.service network-online.target
Requires=clickhouse-server.service

[Service]
Type=oneshot
User=wsprdaemon
Group=wsprdaemon
ExecStart=/usr/local/sbin/ch-sync-peers --lookback 720
TimeoutStartSec=12h
StandardOutput=null
StandardError=journal
