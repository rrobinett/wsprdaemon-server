[Unit]
Description=Move each chirp through its lifecycle on fleet evidence (sigmondb chirp-state)
Wants=sigmondb-solve.service
After=sigmondb-solve.service clickhouse-server.service

[Service]
Type=oneshot
User=wsprdaemon
Group=wsprdaemon
WorkingDirectory=/home/wsprdaemon/wsprdaemon-server
ExecStart=/opt/wsprdaemon-server/venv/bin/python -m sigmondb chirp-state
TimeoutStartSec=15min
NoNewPrivileges=true
Nice=10
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sigmondb-chirp-state
